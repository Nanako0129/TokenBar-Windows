<Window
    x:Class="TokenBar.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            FontSize="16"
            FontWeight="SemiBold"
            Text="TokenBar" />
        <TextBlock
            Grid.Row="1"
            Margin="0,12,0,0"
            x:Name="ProbeText"
            TextWrapping="Wrap"
            Text="skeleton — probe pending" />
    </Grid>
</Window>
