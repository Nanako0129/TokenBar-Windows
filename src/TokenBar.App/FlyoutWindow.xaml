<Window
    x:Class="TokenBar.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="16"
            FontWeight="SemiBold"
            Text="TokenBar" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18">
            <StackPanel>
                <TextBlock x:Name="TodayValue" FontSize="22" FontWeight="SemiBold" Text="—" />
                <TextBlock Opacity="0.65" FontSize="11" Text="today" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TotalValue" FontSize="22" FontWeight="SemiBold" Text="—" />
                <TextBlock Opacity="0.65" FontSize="11" Text="total" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="RateValue" FontSize="22" FontWeight="SemiBold" Text="—" />
                <TextBlock Opacity="0.65" FontSize="11" Text="tok/min" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Opacity="0.8"
            FontSize="12"
            x:Name="CostLine"
            Text="" />

        <ItemsControl Grid.Row="3" x:Name="QuotaList" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="12" Margin="0,0,0,6" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            Grid.Row="4"
            Opacity="0.5"
            FontSize="10"
            x:Name="FooterText"
            Text="" />
    </Grid>
</Window>
