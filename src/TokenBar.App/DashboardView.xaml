<UserControl
    x:Class="TokenBar.App.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,14,16,10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6">
            <Grid>
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="TokenBar" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Right">
                    <!-- Year filter, macOS PopoverView yearMenu parity: hidden
                         until the first payload reports which years exist. -->
                    <DropDownButton
                        x:Name="YearButton"
                        Visibility="Collapsed"
                        FontSize="11"
                        Padding="9,3,9,4"
                        Content="All" />
                    <!-- Manual refresh; swaps to a spinner while a forced
                         re-read (or the initial load) runs — one control,
                         macOS refreshButton parity. -->
                    <Grid VerticalAlignment="Center" Width="26" Height="26">
                        <Button
                            x:Name="RefreshButton"
                            Padding="0"
                            Width="26"
                            Height="26"
                            Background="Transparent"
                            BorderThickness="0">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" Opacity="0.75" />
                        </Button>
                        <ProgressRing
                            x:Name="RefreshSpinner"
                            Width="15"
                            Height="15"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="18">
                <StackPanel>
                    <TextBlock x:Name="TodayValue" FontSize="20" FontWeight="SemiBold" Text="—" />
                    <TextBlock Opacity="0.65" FontSize="11" Text="today" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TotalValue" FontSize="20" FontWeight="SemiBold" Text="—" />
                    <TextBlock Opacity="0.65" FontSize="11" Text="total" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="RateValue" FontSize="20" FontWeight="SemiBold" Text="—" />
                    <TextBlock Opacity="0.65" FontSize="11" Text="tok/min" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="CostLine" Opacity="0.8" FontSize="11" Text="" />
        </StackPanel>

        <!-- Lens switch -->
        <StackPanel
            Grid.Row="1"
            x:Name="TabsPanel"
            Orientation="Horizontal"
            Spacing="4" />

        <!-- Lens content -->
        <ScrollViewer
            x:Name="CardsScroll"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            IsVerticalScrollChainingEnabled="False">
            <ContentPresenter x:Name="ContentHost" />
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="FooterText" Opacity="0.5" FontSize="10" Text="" />
    </Grid>
</UserControl>
