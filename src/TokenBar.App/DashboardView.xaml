<UserControl
    x:Class="TokenBar.App.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="16,14,16,10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="TokenBar" />
            <StackPanel Orientation="Horizontal" Spacing="18">
                <StackPanel>
                    <TextBlock x:Name="TodayValue" FontSize="20" FontWeight="SemiBold" Text="—" />
                    <TextBlock Opacity="0.65" FontSize="11" Text="today" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TotalValue" FontSize="20" FontWeight="SemiBold" Text="—" />
                    <TextBlock Opacity="0.65" FontSize="11" Text="total" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="RateValue" FontSize="20" FontWeight="SemiBold" Text="—" />
                    <TextBlock Opacity="0.65" FontSize="11" Text="tok/min" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="CostLine" Opacity="0.8" FontSize="11" Text="" />
        </StackPanel>

        <!-- Cards -->
        <ScrollViewer
            x:Name="CardsScroll"
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            IsVerticalScrollChainingEnabled="False">
            <StackPanel Spacing="10">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Token Usage" />
                            <TextBlock
                                x:Name="ChartSubtitle"
                                HorizontalAlignment="Right"
                                Opacity="0.6"
                                FontSize="11"
                                Text="30 days" />
                        </Grid>
                        <Canvas x:Name="ChartCanvas" Height="120" SizeChanged="OnChartSizeChanged" />
                        <ItemsControl x:Name="LegendPanel" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Agent limits" />
                        <StackPanel x:Name="LimitsPanel" Spacing="10" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" x:Name="TraceCard">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Live session" />
                        <StackPanel x:Name="TracePanel" Spacing="6" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Models" />
                        <StackPanel x:Name="ModelsPanel" Spacing="8" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Streaks" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel>
                                <TextBlock x:Name="CurrentStreak" FontSize="20" FontWeight="SemiBold" Text="—" />
                                <TextBlock Opacity="0.65" FontSize="11" Text="current" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="LongestStreak" FontSize="20" FontWeight="SemiBold" Text="—" />
                                <TextBlock Opacity="0.65" FontSize="11" Text="longest" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="BestDay" FontSize="20" FontWeight="SemiBold" Text="—" />
                                <TextBlock Opacity="0.65" FontSize="11" Text="best day" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="FooterText" Opacity="0.5" FontSize="10" Text="" />
    </Grid>
</UserControl>
