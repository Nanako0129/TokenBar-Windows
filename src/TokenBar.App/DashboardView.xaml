<UserControl
    x:Class="TokenBar.App.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,14,16,10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6">
            <Grid>
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="TokenBar" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Right">
                    <!-- Year filter, macOS PopoverView yearMenu parity: hidden
                         until the first payload reports which years exist. -->
                    <DropDownButton
                        x:Name="YearButton"
                        Visibility="Collapsed"
                        FontSize="11"
                        Padding="9,3,9,4"
                        Content="All" />
                    <!-- Manual refresh; swaps to a spinner while a forced
                         re-read (or the initial load) runs — one control,
                         macOS refreshButton parity. -->
                    <Grid VerticalAlignment="Center" Width="26" Height="26">
                        <Button
                            x:Name="RefreshButton"
                            Padding="0"
                            Width="26"
                            Height="26"
                            Background="Transparent"
                            BorderThickness="0">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" Opacity="0.75" />
                        </Button>
                        <ProgressRing
                            x:Name="RefreshSpinner"
                            Width="15"
                            Height="15"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="18">
                <StackPanel>
                    <TextBlock x:Name="TodayValue" FontSize="20" FontWeight="SemiBold" Text="—" />
                    <TextBlock Opacity="0.65" FontSize="11" Text="today" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TotalValue" FontSize="20" FontWeight="SemiBold" Text="—" />
                    <TextBlock Opacity="0.65" FontSize="11" Text="total" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="RateValue" FontSize="20" FontWeight="SemiBold" Text="—" />
                    <TextBlock Opacity="0.65" FontSize="11" Text="tok/min" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="CostLine" Opacity="0.8" FontSize="11" Text="" />
        </StackPanel>

        <!-- Lens switch -->
        <StackPanel
            Grid.Row="1"
            x:Name="TabsPanel"
            Orientation="Horizontal"
            Spacing="4" />

        <!-- Lens content -->
        <ScrollViewer
            x:Name="CardsScroll"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            IsVerticalScrollChainingEnabled="False">
            <ContentPresenter x:Name="ContentHost" />
        </ScrollViewer>

        <!-- Dev-only 3D contribution-graph panel (Phase 8 Gate 0). Collapsed
             and empty in normal use; EnableGraph3D() mounts the SwapChainPanel
             and reveals it, overlaying the top of the chart area. Fixed size so
             the swapchain gets a deterministic pixel extent for the soak. -->
        <Border
            x:Name="Graph3DHost"
            Grid.Row="2"
            Visibility="Collapsed"
            Width="352"
            Height="180"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" />

        <!-- Footer, macOS parity: status text left, gear + Quit hugging the
             right edge. -->
        <Grid Grid.Row="3">
            <TextBlock
                x:Name="FooterText"
                VerticalAlignment="Center"
                Opacity="0.5"
                FontSize="10"
                Text="" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="2"
                HorizontalAlignment="Right">
                <Button
                    x:Name="SettingsButton"
                    Padding="0"
                    Width="24"
                    Height="24"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon Glyph="&#xE713;" FontSize="12" Opacity="0.7" />
                </Button>
                <Button
                    x:Name="QuitButton"
                    Padding="7,2,7,3"
                    FontSize="11"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="Quit" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
