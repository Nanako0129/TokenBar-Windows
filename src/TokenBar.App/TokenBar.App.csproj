<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 shell, unpackaged (Velopack deployment; no MSIX). Deliberately
       NOT in TokenBar.slnx: the WASDK toolchain only builds on Windows, and
       the slnx is the macOS-side inner loop. CI builds this project directly. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TokenBar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.*" />
    <!-- Phase 8 Gate 0: 3D contribution graph on D3D11, mirroring the Phase 2
         spike's Vortice stack. DXGI is explicit (composition swapchain +
         IDXGIFactory2.CreateSwapChainForComposition live here). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.*" />
    <PackageReference Include="Vortice.DXGI" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TokenBar.Core\TokenBar.Core.csproj" />
    <ProjectReference Include="..\TokenBar.Interop\TokenBar.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray animation frames, copied verbatim from the macOS repo's
         Resources (anim-cat2 48x48 ×5, anim-parrot 48x36 ×10, plus -light
         variants for a light taskbar). -->
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
