<Project Sdk="Microsoft.NET.Sdk">

  <!-- Swift↔C# fixture cross-check harness (crosscheck/README.md). Console
       tool, macOS-runnable; deliberately NOT in TokenBar.slnx — run with
       `dotnet run -\-project src/TokenBar.CrossCheck`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TokenBar.Core/TokenBar.Core.csproj" />
    <ProjectReference Include="../TokenBar.Interop/TokenBar.Interop.csproj" />
  </ItemGroup>

</Project>
